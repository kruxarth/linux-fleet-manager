    {
      "id": 7,
      "type": "timeseries",
      "title": "Command run time (95th percentile)",
      "description": "95 out of 100 commands finish at least this fast.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "fixed",
