{
  "annotations": {
    "list": []
  },
  "description": "How many machines are online, offline or waiting to join, plus how busy the Fleet Manager is.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 4,
      "type": "stat",
      "title": "Nodes online",
      "description": "Machines that sent a heartbeat recently and can take commands.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#5C6B8A",
                "value": null
              },
              {
                "color": "#1F9D63",
                "value": 1
              }
            ]
          },
          "noValue": "\u2013",
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(fleet_nodes{state=\"online\"}) or vector(0)",
          "legendFormat": "online",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background_solid",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto"
      }
    },
